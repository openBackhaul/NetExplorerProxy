@startuml 027_ProvideLtpEquipmentMappings
skinparam responseMessageBelowArrow true

title PromptForProvidingLtpEquipmentMappingsCausesReadingFromNepCache

participant "external \n(Netexplorer)" as external
participant "NEP://v1/provide-ltp-equipment-mappings" as nep
participant "ElasticSearch \n(or database)" as db

external -> nep: {optional: mount-name-list, data-age (BasicAuth)}
activate nep

nep -> db: (apiAuthKey)
db --> nep: {optional: mount-name-list, data-age} (no security)

nep --> external: {(filtered) mappingList} (no security)

deactivate nep
@enduml