@startuml 030_ProvideAirInterfaceGeneralInfo
skinparam responseMessageBelowArrow true

title PromptForProvidingAirInterfaceGeneralInfoCausesReadingFromNepCache

participant "external \n(Netexplorer)" as external
participant "NEP://v1/provide-air-interface-general-information-of-devices" as nep
participant "ElasticSearch \n(or database)" as db

external -> nep: {optional: mount-name-list (BasicAuth)}
activate nep

nep -> db: (apiAuthKey)
db --> nep: {optional: mount-name-list} (no security)

nep --> external: {(filtered) generalAirInterfaceInfo} (no security)

deactivate nep
@enduml