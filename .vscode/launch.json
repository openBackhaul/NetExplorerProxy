    "version": "0.2.0",
    "configurations": [
    
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {
                "DB": "true",
                "USER": "user",
                "PASSWORD": "mypass",
                "HOST": "localhost",
                "PORT": "3306",
                "DIALECT": "mariadb",
                "DB_NAME": "nep_database"
            },
            "program": "${workspaceFolder}\\server\\index.js"
        }
    ]
}